# Keep the Flutter build context minimal. Anything not needed by
# `flutter pub get` + `flutter build web` should not enter the image.

.git
.github
.idea
.vscode
.dart_tool
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/

# Regenerated by `flutter create` inside the build.
web/
android/
ios/
linux/
macos/
windows/

# Test infra not needed for a web build.
test/
integration_test/

# Local notes that shouldn't end up in the image.
*.md
!pubspec.yaml
