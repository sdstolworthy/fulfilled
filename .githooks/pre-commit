#!/usr/bin/env bash
# Pre-commit lint gate.
#
# Runs the strict analyzer + clippy + rustfmt suite against the
# *working tree* (not the staged subset — partial staging will not be
# detected). On failure the commit is blocked.
#
# Strictness (intentional, per repo policy):
#   - `flutter analyze --fatal-infos --fatal-warnings` — info-level
#     lints (e.g. `require_trailing_commas`) count as errors.
#   - `cargo clippy --all-targets -- -D warnings` — any clippy lint
#     is fatal.
#   - `cargo fmt --all -- --check` — formatting drift is fatal.
#
# Every commit runs the full suite — flutter analyze + cargo clippy +
# cargo fmt — regardless of which side of the repo it touches. The
# earlier path-scoped skip turned out to be a false economy: a
# server-only commit can still break client code via shared specs,
# and the analyzer is fast (~3 s) compared to clippy.
#
# We DO isolate the index before running analyzers: unstaged tracked
# changes and untracked files are stashed for the duration of the
# hook, so the tools see exactly what's about to be committed.
# Without this, a WIP test scratchpad sitting in the working tree
# can block an otherwise clean commit with its own analyzer noise.
# The stash is always popped on exit so user state is preserved.
#
# Escape hatch: `git commit --no-verify` skips this hook. Use sparingly
# — the strict mode exists to keep tree green, not to harass.
#
# Toolchain discovery:
#   - flutter: `$FLUTTER_BIN`, then `flutter` on PATH, then
#     `~/flutter/bin/flutter`.
#   - cargo: `cargo` on PATH (rustup's standard install location).

set -euo pipefail

# All sub-paths resolve against the repo root, regardless of where
# `git commit` was invoked.
cd "$(git rev-parse --show-toplevel)"

red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }

# ─── Isolate the index ─────────────────────────────────────────────────
# Stash anything that isn't staged (modified-but-unstaged tracked
# files + all untracked files). The trap ensures we always pop on
# exit so the user's WIP is preserved even on hook failure.
stash_sha=""
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  before=$(git rev-parse --quiet --verify refs/stash 2>/dev/null || true)
  if git stash push --keep-index --include-untracked --message "pre-commit-isolate" >/dev/null 2>&1; then
    after=$(git rev-parse --quiet --verify refs/stash 2>/dev/null || true)
    if [ -n "$after" ] && [ "$before" != "$after" ]; then
      stash_sha=$after
    fi
  fi
fi

restore_stash() {
  if [ -n "$stash_sha" ]; then
    if ! git stash pop "$stash_sha" >/dev/null 2>&1; then
      yellow "pre-commit: warning — could not auto-pop stash $stash_sha"
      yellow "  recover manually: git stash list / git stash pop"
    fi
  fi
}
trap restore_stash EXIT

# ─── Flutter ────────────────────────────────────────────────────────────
FLUTTER_BIN="${FLUTTER_BIN:-}"
if [ -z "$FLUTTER_BIN" ]; then
  if command -v flutter >/dev/null 2>&1; then
    FLUTTER_BIN="flutter"
  elif [ -x "$HOME/flutter/bin/flutter" ]; then
    FLUTTER_BIN="$HOME/flutter/bin/flutter"
  else
    red "pre-commit: flutter not found (set FLUTTER_BIN or add to PATH)"
    exit 1
  fi
fi

yellow "pre-commit › flutter analyze (client/, --fatal-infos --fatal-warnings)"
(
  cd client
  "$FLUTTER_BIN" analyze --fatal-infos --fatal-warnings
)

# ─── Cargo (server) ─────────────────────────────────────────────────────
# Mirror flutter's discovery: explicit override, then PATH, then the
# rustup standard install location. The latter matters when the hook is
# invoked by a shell without `~/.cargo/bin` on PATH (e.g. CI, the
# Claude Code harness).
CARGO_BIN="${CARGO_BIN:-}"
if [ -z "$CARGO_BIN" ]; then
  if command -v cargo >/dev/null 2>&1; then
    CARGO_BIN="cargo"
  elif [ -x "$HOME/.cargo/bin/cargo" ]; then
    CARGO_BIN="$HOME/.cargo/bin/cargo"
  else
    red "pre-commit: cargo not found (set CARGO_BIN or add to PATH)"
    exit 1
  fi
fi

yellow "pre-commit › cargo fmt --check (server/)"
(
  cd server
  "$CARGO_BIN" fmt --all -- --check
)

yellow "pre-commit › cargo clippy -D warnings (server/)"
(
  cd server
  "$CARGO_BIN" clippy --all-targets --all-features -- -D warnings
)

green "pre-commit › ok"
