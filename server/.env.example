# Copy this file to .env and tweak as needed.
# `docker compose up -d` provisions the matching Postgres instance.

DATABASE_URL=postgres://loseit:loseit@localhost:5432/loseit
LOSEIT_BIND=0.0.0.0:8080
LOSEIT_RUN_MIGRATIONS=true
RUST_ENV=development
RUST_LOG=info,tower_http=info,sqlx=warn

# Local-dev authentication bypass. Off in prod — the binary refuses to
# start with DEV_AUTH_BYPASS=true and RUST_ENV=production simultaneously.
DEV_AUTH_BYPASS=true
DEV_AUTH_TOKEN=dev-token
DEV_AUTH_ISSUER=dev
DEV_AUTH_USER_ID=dev-user
DEV_AUTH_EMAIL=dev@example.com
DEV_AUTH_DISPLAY_NAME=Dev User

# OIDC config — only consulted when DEV_AUTH_BYPASS is false.
# OIDC_ISSUER=https://your-idp.example/
# OIDC_JWKS_URL=https://your-idp.example/.well-known/jwks.json
