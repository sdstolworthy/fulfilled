# Test artifacts that should not be checked in. The `screenshots/`
# directory itself is tracked (via `.gitkeep`) so CI can drop artifacts
# into it on every run, but individual PNGs are ignored.
node_modules/
playwright-report/
test-results/
screenshots/*.png
!screenshots/.gitkeep

# Package manager noise. Lockfile stays committed.
.npm/
.pnpm-debug.log*
.yarn/
